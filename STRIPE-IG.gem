# local x = 320

pa_define($(x),$(x),1500,planar,n,e,10,1,1)

;--Trap------------------------------------------------------------------------------------------------
locate(0,0,0,1,0,0) {
    ; first segment of STRIPE trap electrodes (5th segment in STRIPE)
    locate($(x/2),$(x/2),50,1,0,0) {
        ; First pair electrodes in this segment
        	electrode(1){
			fill{
				within{
					cylinder(61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(-61.5,-61.5,0,46,46,50)
				}
			}
		}
        ; Second pair electrodes in this segment
		electrode(2){
			fill{
				within{
					cylinder(-61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(61.5,-61.5,0,46,46,50)
				}
			}
		}
	}

    ; second segment of STRIPE trap electrodes (6th segment in STRIPE)
    locate($(x/2),$(x/2),110,1,0,0) {
        ; First pair electrodes in this segment
        	electrode(3){
			fill{
				within{
					cylinder(61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(-61.5,-61.5,0,46,46,50)
				}
			}
		}
        ; Second pair electrodes in this segment
		electrode(4){
			fill{
				within{
					cylinder(-61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(61.5,-61.5,0,46,46,50)
				}
			}
		}
	}

    ; third segment of STRIPE trap electrodes (6th segment in STRIPE)
    locate($(x/2),$(x/2),170,1,0,0) {
        ; First pair electrodes in this segment
        	electrode(5){
			fill{
				within{
					cylinder(61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(-61.5,-61.5,0,46,46,50)
				}
			}
		}
        ; Second pair electrodes in this segment
		electrode(6){
			fill{
				within{
					cylinder(-61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(61.5,-61.5,0,46,46,50)
				}
			}
		}
	}

    ; fourth segment of STRIPE trap electrodes (6th segment in STRIPE)
    locate($(x/2),$(x/2),230,1,0,0) {
        ; First pair electrodes in this segment
        	electrode(7){
			fill{
				within{
					cylinder(61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(-61.5,-61.5,0,46,46,50)
				}
			}
		}
        ; Second pair electrodes in this segment
		electrode(8){
			fill{
				within{
					cylinder(-61.5,61.5,0,46,46,50)
				}
				within{
					cylinder(61.5,-61.5,0,46,46,50)
				}
			}
		}
	}

    ;grounded trap cross
	locate($(x/2),$(x/2),290,1,0,0,0){
		electrode(9){
			fill{
				within{
					cylinder(0,0,0,150,150,50)
				}
				notin{
					cylinder(0,0,0,15,15,50)
				}
			}
		}
	}
}

;--Ion Guide-------------------------------------------------------------------------------------------
; I add here the first half of the IG + 10 mm to make sure no fringe effects take place
; A 1 mm spacer between STRIPE cross and IG
locate(0,0,300,1,0,0) {
	;first set of electrodes
	locate($(x/2),$(x/2),1192.05,1,0,0,0){
		electrode(10){
			fill{
				within{
					cylinder(31.4,31.4,0,23.75,23.75,1192.05)
				}
				within{
					cylinder(-31.4,-31.4,0,23.75,23.75,1192.05)
				}
			}
		}
		electrode(11){
			fill{
				within{
					cylinder(-31.4,31.4,0,23.75,23.75,1192.05)
				}
				within{
					cylinder(31.4,-31.4,0,23.75,23.75,1192.05)
				}
			}
		}
	}
}
